# Скопируй в glassfish-server.conf и положи рядом с WAR и JDBC-драйвером.
# Нужен свободный порт приложения. GlassFish займёт и другие порты рядом с ним.
HTTP_PORT=

# Адрес БД из задания. Пустой DB_USER означает логин текущего пользователя сервера.
DB_HOST=pg
DB_PORT=5432
DB_NAME=studs
DB_USER=

# По умолчанию скрипт читает ~/.pgpass (или PGPASSFILE, если задана).
# Укажи абсолютный путь, только если пароль БД хранится в другом файле .pgpass.
DB_PASSFILE=

# Заполни, если таблицы должны находиться в явно указанной личной схеме PostgreSQL.
# Схема должна уже существовать; этот файл её не создаёт.
DB_SCHEMA=

# Если GlassFish уже распакован, укажи абсолютный путь к каталогу glassfish7.
# Иначе положи glassfish-7.1.1.zip рядом с этим конфигом.
GLASSFISH_HOME=
