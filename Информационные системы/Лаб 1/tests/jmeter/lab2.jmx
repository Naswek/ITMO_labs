        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="13. Cleanup imported works" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="filename">tests/jmeter/cleanup.groovy</stringProp>
