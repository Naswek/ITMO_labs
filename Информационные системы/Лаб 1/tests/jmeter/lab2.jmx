          <stringProp name="filename">tests/jmeter/discipline_race.groovy</stringProp>
          <stringProp name="parameters"/>
          <stringProp name="cacheKey">lab2-discipline</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="11. Concurrent author and discipline pair" enabled="true">
